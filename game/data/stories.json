              {
                "type": "item",
                "id": "linchong_token",
                "amount": 1
              },
              {
                "type": "currency",
                "id": "prestige",
                "amount": 20
              }
            ]
          }
        ],
        "condition": {
          "flag": "chai_refuge"
        },
        "hint": "持投庄书拜访柴进，交书并领受护送之约后，再回梁山渡口。"
      }
    }
  },
