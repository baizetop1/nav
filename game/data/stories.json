              },
              {
                "type": "item",
                "id": "exp_pill",
                "amount": 5
              },
              {
                "type": "currency",
                "id": "prestige",
                "amount": 30
              }
            ]
          }
        ]
      },
      "departure": {
        "map": "ferry",
        "text": "柴庄的热饭与书信让人缓过气来，却不能替林冲决定归处。渡口芦苇摇动，他望着梁山道：“世路既不容我，且向水泊去。”你记下这段由隐忍至决绝的往事。",
        "choices": [
          {
            "id": "finish",
            "label": "记下风雪归途",
            "finish": true,
            "effects": [
              {
                "type": "flag",
