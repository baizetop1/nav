              "guest": {
                "id": "linchong",
                "level": 30
              }
            }
          }
        ]
      },
      "aftermath": {
        "map": "mountain_temple",
        "text": "林冲亲手了断陆谦等人的追害，收枪立在风雪里。他没有再提安分求生，只问：“前方可还有容身之地？”你想起柴进好客，托人写下一封投庄书。",
        "choices": [
          {
            "id": "letter",
            "label": "收好书信，指向柴进庄",
            "next": "departure",
            "effects": [
              {
                "type": "flag",
