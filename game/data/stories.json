    "steps": {
      "tolerance": {
        "map": "dongjing_lane",
        "text": "林冲听你说起江湖风声，仍只低声道：“林某只是个教头，守好本分便罢。”门外有人提起高衙内，他握住枪杆，又缓缓放开。",
        "choices": [
          {
            "id": "greet",
            "label": "与教头叙过姓名",
            "next": "escort",
            "effects": [
              {
                "type": "hero",
                "id": "linchong",
                "status": "known"
              },
              {
                "type": "flag",
                "id": "lin_tolerant"
              }
            ]
          }
        ]
      },
      "escort": {
        "map": "boar_forest",
        "text": "再见时林冲已戴上枷锁。他不愿连累旁人，任由董超、薛霸把他领入林中。你不能替他挣脱，只能留意树后的动静；鲁智深曾答应沿路照看。",
        "choices": [
          {
            "id": "watch",
            "label": "留意林中动静，等候接应",
