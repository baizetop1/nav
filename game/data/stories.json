                "type": "flag",
                "id": "lin_escort"
              }
            ]
          }
        ]
      },
      "roadout": {
        "map": "boar_forest",
        "text": "禅杖挡开水火棍。林冲劝住鲁智深：“且留他们性命，还须押我到沧州。”他仍想在律法之内寻一条活路。",
        "choices": [
          {
            "id": "escort",
            "label": "陪行至沧州",
            "next": "cangzhou",
            "effects": [
              {
                "type": "flag",
                "id": "lin_cangzhou"
