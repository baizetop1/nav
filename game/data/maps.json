        "id": "forge_new_method",
        "label": "请教风雪淬炼法",
        "once": true,
        "condition": {
          "flag": "lin_temple"
        },
        "text": "铁匠听完草料场的风雪，说起冷热相济的锻法。强化上限开放至 +10；+6 起需强化符，八成可成，失败只耗材料，不降级、不毁装备。",
        "effects": [
          {
            "type": "flag",
            "id": "advanced_forge"
          }
        ]
      }
    ],
