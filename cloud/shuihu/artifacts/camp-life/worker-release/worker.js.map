  {
    "id": "linchong_story",
    "title": "林冲 · 风雪归途",
    "map": "dongjing_lane",
    "start": "tolerance",
    "condition": {
      "flag": "volume_complete"
    },
    "steps": {
      "tolerance": {
        "map": "dongjing_lane",
        "text": "林冲听你说起江湖上的事，低声道：“林某在禁军当差，外头的事少有耳闻。”门外忽有人提起高衙内，他握紧枪杆，半晌才松开。",
        "choices": [
          {
            "id": "greet",
            "label": "报上姓名",
            "next": "escort",
            "effects": [
              {
                "type": "hero",
                "id": "linchong",
                "status": "known"
              },
              {
                "type": "flag",
                "id": "lin_tolerant"
              }
            ]
          }
        ]
      },
      "escort": {
        "map": "boar_forest",
        "text": "再见林冲时，他颈上已经套了枷。董超催他赶路，薛霸将他往林深处推。你跟在后面，朝树丛里望了望——鲁智深说过，要沿途照看。",
        "choices": [
          {
            "id": "watch",
            "label": "跟进林中，等鲁智深接应",
            "next": "roadout",
            "effects": [
              {
                "type": "flag",
                "id": "lin_escort"
              }
            ]
          }
        ]
      },
      "roadout": {
        "map": "boar_forest",
        "text": "禅杖挑开水火棍，董超、薛霸跌坐在地。林冲忙喊：“师兄且住！留他们性命，还须押我到沧州。”鲁智深收住杖，朝两人啐了一口。",
        "choices": [
          {
            "id": "escort",
            "label": "陪林冲去沧州",
            "next": "cangzhou",
            "effects": [
              {
                "type": "flag",
                "id": "lin_cangzhou"
              }
            ],
            "goMap": "cangzhou"
          }
        ],
        "condition": {
          "flag": "lu_complete"
        },
        "hint": "先去大相国寺、菜园结识鲁智深，再回野猪林救下林冲。"
      },
      "cangzhou": {
        "map": "cangzhou_inn",
        "text": "李小二一眼认出林冲，赶忙迎进店里。说起近日有生客打听草料场，他压低声音：“恩人多留个心。”林冲捧着热酒，点了点头。",
        "choices": [
          {
            "id": "warn",
            "label": "托李小二留意生客",
            "next": "depot",
            "effects": [
              {
                "type": "flag",
                "id": "lin_warned"
              },
              {
                "type": "item",
                "id": "jinchuangyao",
                "amount": 2
              }
            ]
          },
          {
            "id": "duty",
            "label": "叮嘱林冲当值小心",
            "next": "depot",
            "effects": [
              {
                "type": "item",
                "id": "iron",
                "amount": 2
              }
            ]
          }
        ]
      },
      "depot": {
        "map": "feed_depot",
        "text": "雪压得草屋咯吱作响，半边屋顶塌了下来。林冲拨开雪，摸过火盆，确认火种已灭，便提枪挑起酒葫芦出门。你沿山道找去，前方隐约有座破庙。",
        "choices": [
          {
            "id": "shelter",
            "label": "上山寻个避雪处",
            "next": "listen",
            "effects": [],
            "goMap": "snow_road"
          }
        ]
      },
      "listen": {
        "map": "mountain_temple",
        "text": "庙外三人望着草料场的大火，说起如何烧死林冲。听到陆谦的声音，林冲端着酒碗的手停住了。他轻轻放下碗，伸手去取花枪。",
        "choices": [
          {
            "id": "hear",
            "label": "听清门外三人的话",
            "next": "confront",
            "effects": [
              {
                "type": "flag",
                "id": "lin_resolved"
              }
            ]
          }
        ]
      },
      "confront": {
        "map": "mountain_temple",
        "text": "林冲搬开门后的石头，挺枪冲了出去：“陆谦！我与你自幼相交，你倒这样害我！”陆谦转身要逃，富安从一旁逼来。你急忙出声提醒。",
        "choices": [
          {
            "id": "fight",
            "label": "助林冲挡住夹击",
            "next": "aftermath",
            "effects": [],
            "battle": {
              "enemies": [
                "luqian",
                "fuan"
              ],
              "guest": {
                "id": "linchong",
                "level": 30
              }
            }
          }
        ]
      },
      "aftermath": {
        "map": "mountain_temple",
        "text": "林冲收回花枪，立在风雪里许久，才问：“如今还能往哪里去？”你提起柴进庄，托人写了封投庄书。林冲接过书信，藏进怀里。",
        "choices": [
          {
            "id": "letter",
            "label": "收好投庄书",
            "next": "departure",
            "effects": [
              {
                "type": "flag",
                "id": "lin_temple"
              },
              {
                "type": "item",
                "id": "linchong_token",
                "amount": 2
              },
              {
                "type": "item",
                "id": "refuge_letter",
                "amount": 1
              },
              {
                "type": "item",
                "id": "exp_pill",
                "amount": 5
              },
              {
                "type": "currency",
                "id": "prestige",
                "amount": 30
              }
            ]
          }
        ]
      },
      "departure": {
        "map": "ferry",
        "text": "离了柴进庄，林冲一路来到渡口。风吹得芦苇沙沙响，他望着水面问：“去梁山的船，几时来？”你同他在岸边等候，直到远处露出一支船篙。",
        "choices": [
          {
            "id": "finish",
            "label": "陪林冲等船",
            "finish": true,
            "effects": [
              {
                "type": "flag",
                "id": "lin_departure"
              },
              {
                "type": "item",
                "id": "linchong_token",
                "amount": 1
              },
              {
                "type": "currency",
                "id": "prestige",
                "amount": 20
              }
            ]
          }
        ],
        "condition": {
          "flag": "chai_refuge"
        },
        "hint": "带投庄书去见柴进，交书并应下护送之约后，再回梁山渡口。"
      }
    }
  },
